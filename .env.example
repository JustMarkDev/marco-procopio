# Set this to the stable production domain after the first Vercel deployment.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Connect an Upstash Redis database in Vercel to persist the public page-view counter.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token
