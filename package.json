{
  "name": "marco-procopio",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^7.0.2",
      "@types/node": "^26.6.3",
      "varlock": "1.21.1",
      "next-themes": "^0.4.6",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "dev:web": "vp run --filter web dev",
    "build": "vp run -r build",
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt",
    "test": "vp test run --passWithNoTests",
    "test:e2e": "vp run --filter web test:e2e",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "env:generate": "varlock codegen --path ./apps/web/",
    "postinstall": "varlock codegen --path ./apps/web/"
  },
  "devDependencies": {
    "@marco-procopio/config": "workspace:*",
    "@types/node": "catalog:",
    "rolldown": "1.2.12",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  }
}
