# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Optional GitHub token for the repo activity fetch (raises the API rate limit).
# @optional @sensitive
GITHUB_TOKEN=

# Last.fm API key for the now playing widget.
# @optional @sensitive
LASTFM_API_KEY=

# Trakt app client ID for favourite films and series.
# @optional @sensitive
TRAKT_CLIENT_ID=

# Steam Web API key for most played games.
# @optional @sensitive
STEAM_API_KEY=
